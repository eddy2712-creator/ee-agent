# Resend
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# Primary recipient(s) — comma-separate for multiple To addresses
EMAIL_TO=info@eecontracting.ca

# Optional CC recipient(s) — comma-separated. Leave blank to disable CC.
EMAIL_CC=ewhyte2712@gmail.com

# Recipient for the morning/evening call-forwarding reminders.
# Gets the same EMAIL_CC treatment as the call summaries.
CRAIG_EMAIL=info@eecontracting.ca

# Jobber OAuth — get values from developer.getjobber.com
# Visit /jobber/connect to authorize, then paste the displayed refresh token here.
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=https://ee-agent-production.up.railway.app/jobber/callback
JOBBER_REFRESH_TOKEN=
